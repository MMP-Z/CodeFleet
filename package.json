{
  "name": "codefleet",
  "version": "0.1.0",
  "private": true,
  "description": "CodeFleet — Ứng dụng desktop điều phối AI CLI để vibe code có hiểu",
  "main": "./out/main/index.cjs",
  "author": "CodeFleet Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-rebuild -f -w better-sqlite3 && electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dir": "pnpm build && electron-rebuild -f -w better-sqlite3 && electron-builder --dir --publish never",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "better-sqlite3": "^13.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.22.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "7zip-bin",
      "esbuild"
    ]
  }
}
